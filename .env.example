# ==============================================================================
# ZENITH — Team No. 5 | Environment Variables Template
# ==============================================================================
# IMPORTANT:
# - Never commit real secrets or production keys into version control.
# - Do NOT expose SUPABASE_SERVICE_ROLE_KEY to mobile client bundles or public web pages.
# - Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Core Configuration (Shared)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Supabase Anonymous Public Key (Safe for client-side reads subjected to RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE"

# ------------------------------------------------------------------------------
# 2. Supabase Backend / Admin Operations (STRICTLY SERVER-SIDE / CLI ONLY)
# ------------------------------------------------------------------------------
# NEVER prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_. Keep out of all client code!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY_HERE"
SUPABASE_DB_PASSWORD="YOUR_DATABASE_POSTGRES_PASSWORD"

# ------------------------------------------------------------------------------
# 3. Application Metadata & Feature Flags
# ------------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV="development" # development | staging | production
EXPO_PUBLIC_APP_NAME="ZENITH — Team No. 5"
EXPO_PUBLIC_APP_VERSION="1.0.0"

# Public Showcase Domain URL
NEXT_PUBLIC_SHOWCASE_BASE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. EAS Build & Deployment (Expo Application Services)
# ------------------------------------------------------------------------------
# EAS Project ID (Configured via eas init / app.json)
EAS_PROJECT_ID="YOUR_EAS_PROJECT_UUID_HERE"
