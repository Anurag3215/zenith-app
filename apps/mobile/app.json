{
  "expo": {
    "name": "ZENITH — Team No. 5",
    "slug": "zenith-team-5",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zenith",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#050814",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.zenith5.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "ZENITH requires camera access to document mPOWER training workshops, presentation evidence, and official scoreboard verification.",
        "NSPhotoLibraryUsageDescription": "ZENITH requires photo library access to upload training artifacts and verified team presentation media."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050814"
      },
      "package": "edu.zenith5.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
